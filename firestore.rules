rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRestaurant(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.googleReviewUrl is string && data.googleReviewUrl.size() <= 1000
        && (!('adminPin' in data) || (data.adminPin is string && data.adminPin.size() <= 32))
        && (!('adminEmail' in data) || (data.adminEmail is string && data.adminEmail.size() <= 120))
        && (!('tables' in data) || (data.tables is list && data.tables.size() <= 200))
        && (!('customGameQuestions' in data) || data.customGameQuestions is map)
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidFeedback(data, restaurantId) {
      return data.restaurantId == restaurantId
        && data.table is string && data.table.size() > 0 && data.table.size() <= 50
        && data.type in ['review', 'complaint', 'suggestion']
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 80))
        && (!('status' in data) || data.status in ['new', 'investigating', 'resolved'])
        && (!('resolutionNotes' in data) || (data.resolutionNotes is string && data.resolutionNotes.size() <= 1000))
        && (!('googleReviewRedirected' in data) || data.googleReviewRedirected is bool)
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Restaurants
    match /restaurants/{restaurantId} {
      // Dining customers need to read restaurant name, Google Review link, tables, and questions
      allow get: if isValidId(restaurantId);
      allow list: if true;
      allow create: if isValidId(restaurantId) && isValidRestaurant(incoming());
      allow update: if isValidId(restaurantId) && isValidRestaurant(incoming());
      allow delete: if request.auth != null;

      // Customer Feedbacks & Complaints Subcollection
      match /feedbacks/{feedbackId} {
        // Customers create feedback from their tables without login
        allow create: if isValidId(feedbackId) && isValidFeedback(incoming(), restaurantId);
        // Restaurant admins and staff can read, update status, and manage feedback
        allow read: if true;
        allow update: if isValidId(feedbackId) && isValidFeedback(incoming(), restaurantId);
        allow delete: if request.auth != null;
      }
    }
  }
}
